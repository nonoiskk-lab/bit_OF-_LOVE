# Copy to .env.local and fill in your own values. Never commit real secrets.

# Admin dashboard (/admin) login — required for it to work at all; unset means
# login always fails closed (secure default), not open.
ADMIN_PASSWORD=
# Random signing secret for the admin session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# Production storage (orders, bookings, catering leads). REQUIRED on Vercel —
# without these, submissions return a clear "not saved, please WhatsApp us" error
# because Vercel's filesystem is read-only. Create the table with supabase/schema.sql.
# The service-role key is server-only: never prefix it with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL used for canonical links, Open Graph, robots.txt and sitemap.xml.
# Defaults to https://bit-of-love.vercel.app — change when a custom domain goes live.
NEXT_PUBLIC_SITE_URL=
