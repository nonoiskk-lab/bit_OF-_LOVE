# Copy to .env.local and fill in your own values. Never commit real secrets.

# Admin dashboard (/admin) login — required for it to work at all; unset means
# login always fails closed (secure default), not open.
ADMIN_PASSWORD=
# Random signing secret for the admin session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# WhatsApp Cloud API (Meta) — powers the admin "WhatsApp Marketing" tab.
# Create a WhatsApp Business app at developers.facebook.com, get a
# phone number ID and a permanent access token, and get your message
# template(s) approved in Meta Business Manager before sending.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Optional — defaults to v21.0.
WHATSAPP_API_VERSION=
